  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-solid": "^0.18.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
